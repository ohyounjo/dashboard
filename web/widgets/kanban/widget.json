{
  "type": "kanban",
  "label": "칸반",
  "options": {
    "type": "object",
    "required": ["dataset", "group_by", "columns", "card"],
    "properties": {
      "dataset": { "$ref": "#/$defs/key" },
      "group_by": { "$ref": "#/$defs/column", "x-column": true },
      "columns": {
        "description": "칸 순서. group_by 값이 어느 칸에도 없으면 그 카드는 표시하지 않고 콘솔 경고",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "label"],
          "properties": {
            "value": { "type": "string" },
            "label": { "type": "string", "minLength": 1 },
            "icon": { "description": "이 칸 카드 제목 앞에 붙는 이모지", "type": "string", "minLength": 1, "maxLength": 8, "default": null },
            "tone": { "$ref": "#/$defs/tone", "default": null }
          }
        },
        "x-unique": { "key": "value", "name": "칸" }
      },
      "card": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "$ref": "#/$defs/column", "x-column": true },
          "chips": { "type": "array", "items": { "$ref": "#/$defs/column", "x-column": true }, "default": [] }
        }
      },
      "filter": {
        "description": "칸반 위 선택 상자. 선택지는 행의 고유값(정렬)",
        "type": "object",
        "additionalProperties": false,
        "required": ["column", "label"],
        "properties": {
          "column": { "$ref": "#/$defs/column", "x-column": true },
          "label": { "type": "string", "minLength": 1 }
        },
        "default": null
      }
    }
  }
}
