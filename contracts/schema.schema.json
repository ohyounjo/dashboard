{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashkit.invalid/contracts/schema.schema.json",
  "title": "projects/<이름>/schema.yaml",
  "description": "CSV 테이블과 검증 규칙. 테이블 키 = data/<키>.csv = raw.<키>. 키 참조(ref 대상, 예약어, 순환)는 JSON Schema로 표현할 수 없어 dashkit/config.py가 추가로 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tables"],
  "properties": {
    "version": { "$ref": "#/$defs/version" },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/ident" },
      "additionalProperties": { "$ref": "#/$defs/table" }
    }
  },
  "$defs": {
    "version": {
      "description": "설정 형식 버전(선택. 없으면 1). 이 dashkit이 지원하는 버전보다 크면 config.py가 '<파일>:version: …' 오류로 거부한다. 형식 변경 기록은 CHANGELOG.md, 고치는 명령은 dashkit migrate.",
      "type": "integer",
      "minimum": 1
    },
    "ident": {
      "description": "snake_case 식별자. SQL 예약어는 config.py가 별도로 거부한다.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_key", "columns"],
      "properties": {
        "description": { "type": "string" },
        "primary_key": {
          "description": "열 하나 또는 복합 키. PK 열은 자동으로 required다.",
          "oneOf": [
            { "$ref": "#/$defs/ident" },
            { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ident" } }
          ]
        },
        "columns": {
          "description": "CSV 머리글은 이 열들과 정확히 같은 집합이어야 한다(순서 무관).",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/ident" },
          "additionalProperties": { "$ref": "#/$defs/column" }
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "integer", "number", "boolean", "date", "timestamp", "enum"] },
        "required": { "type": "boolean", "default": false },
        "values": {
          "description": "type: enum일 때만, 그리고 반드시 쓴다.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ref": {
          "description": "\"<테이블>.<열>\". 대상 열은 그 테이블의 단일 열 primary_key여야 한다. DB에 FK로 만든다.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "min": { "description": "integer, number, date(\"YYYY-MM-DD\")에서만", "type": ["number", "string"] },
        "max": { "description": "integer, number, date(\"YYYY-MM-DD\")에서만", "type": ["number", "string"] },
        "pattern": { "description": "text, enum에서만. 값 전체에 대해 검사한다(Python re.fullmatch).", "type": "string", "format": "regex" },
        "description": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": { "required": ["values"] },
          "else": { "not": { "required": ["values"] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["boolean", "timestamp"] } } },
          "then": { "not": { "anyOf": [{ "required": ["min"] }, { "required": ["max"] }] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["integer", "number", "boolean", "date", "timestamp"] } } },
          "then": { "not": { "required": ["pattern"] } }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sql"],
      "properties": {
        "name": { "description": "위반 시 출력하는 규칙 이름", "type": "string", "minLength": 1 },
        "sql": {
          "description": "위반 행을 돌려주는 SELECT. 첫 열을 위반 행의 키로 출력한다. raw.*, dash.* 뷰, dash.as_of()를 쓸 수 있다. 한 행이라도 나오면 적재 전체를 롤백한다.",
          "type": "string", "minLength": 1
        }
      }
    }
  }
}
