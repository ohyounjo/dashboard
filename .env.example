# dashkit 환경변수. `make env`가 이 파일을 .env로 복사하고 __GENERATE__ 자리를 임의 값(hex 48자)으로 채운다.
# .env는 커밋하지 않는다.

# ---------------------------------------------------------------- 프로젝트
# projects/<PROJECT>/ 를 읽는다. 바꾼 뒤 `make apply`
PROJECT=devtracker
# 기준 시간대. as_of: today 계산과 backend 날짜에 쓴다
TZ=Asia/Seoul

# ---------------------------------------------------------------- 포트(127.0.0.1에만 열린다)
# 웹앱(nginx)
WEB_PORT=8080
# Superset(브라우저 iframe과 관리 화면)
SUPERSET_PORT=8088

# 구성 화면 Studio(make studio로만 뜬다. 인증이 없으니 외부에 열지 않는다)
STUDIO_PORT=8090

# ---------------------------------------------------------------- 출처와 주소
# 웹앱을 여는 출처(쉼표 구분). Superset frame-ancestors와 임베드 allowed_domains에 같이 쓴다
WEB_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# 브라우저가 Superset에 접속하는 주소(iframe src, 웹앱 CSP frame-src)
SUPERSET_PUBLIC_URL=http://localhost:8088
# 컨테이너 안에서 Superset에 접속하는 주소(sync, 테스트)
SUPERSET_URL=http://superset:8088

# ---------------------------------------------------------------- Superset
# Superset 버전. 이 한 곳만 바꾼다(superset/Dockerfile의 ARG와 compose 이미지 태그가 읽는다).
# 올릴 때는 contracts/superset-upgrade.md 절차를 따른다
SUPERSET_VERSION=6.1.0
# 관리자 계정. sync와 테스트만 쓴다(backend에는 주지 않는다)
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=__GENERATE__
# sync가 만든 Superset 객체의 화면 편집을 막는다(1, 기본). 0이면 막지 않는다(contracts/state-and-uuid.md "표식")
SYNC_LOCK_UI=1
# Flask SECRET_KEY. 한 번 정하면 바꾸지 않는다(메타데이터 DB의 암호화된 값이 이 키에 묶인다)
SUPERSET_SECRET_KEY=__GENERATE__
# Superset 메타데이터 DB(superset-db) 비밀번호
SUPERSET_DB_PASSWORD=__GENERATE__

# ---------------------------------------------------------------- guest token
# backend가 guest token(JWT, HS256)을 서명하고 Superset이 검증하는 공유 비밀값
GUEST_TOKEN_JWT_SECRET=__GENERATE__
# guest token의 aud. backend와 Superset이 같은 값을 쓴다
GUEST_TOKEN_JWT_AUDIENCE=dashkit-embed

# ---------------------------------------------------------------- 데이터 DB(data-db)
DATA_DB_HOST=data-db
DATA_DB_PORT=5432
DATA_DB_NAME=dash
# 관리용 superuser(postgres). initdb와 비상 관리에만 쓴다. 어떤 서비스에도 주지 않는다
DATA_DB_ADMIN_PASSWORD=__GENERATE__
# 소유자 계정(raw·dash 스키마 소유, superuser 아님, CREATEDB). 로더(tools)만 쓴다
DATA_DB_OWNER_USER=dash_owner
DATA_DB_OWNER_PASSWORD=__GENERATE__
# 읽기 전용 계정(dash 스키마 SELECT만). backend와 Superset이 쓴다
DATA_DB_READER_USER=dash_reader
DATA_DB_READER_PASSWORD=__GENERATE__
# 인증 계정(dashkit_auth 스키마의 표만 SELECT·INSERT·UPDATE·DELETE). backend의 로그인·운용 API가 쓴다.
# raw·dash는 읽지 못한다. 예전에 만든 .env에 없으면 make up·make auth-init이 임의 값으로 채운다
DATA_DB_AUTH_USER=dash_auth
DATA_DB_AUTH_PASSWORD=__GENERATE__
# 운용자 조회용 읽기 계정(raw·dash·dashkit_meta SELECT만). 관리 서비스(make manage)의 조회·목록이 쓴다.
# 쓰지 못하고 dashkit_auth를 읽지 못한다. 예전에 만든 .env에 없으면 make up·make data-init이 임의 값으로 채운다
DATA_DB_INSPECT_USER=dash_inspect
DATA_DB_INSPECT_PASSWORD=__GENERATE__

# ---------------------------------------------------------------- 계획 및 행 지문(contracts/plan.md)
# 적재 기록(dashkit_meta.row_fingerprint)의 HMAC-SHA256 비밀 키(16자 이상, make env/env-secrets가 48자 hex로 생성).
# tools·studio·manager에만 전달하고 backend·superset·data-db·web에는 주지 않는다.
PLAN_FINGERPRINT_KEY=__GENERATE__
# plan의 SQL 뷰 열 분석(PQprepare/PQdescribePrepared) 시간 제한(밀리초, 기본 15000)
PLAN_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------- 상태와 빌드 산출물(컨테이너 안 경로)
# 임베드 UUID, 관리 객체 목록(sync가 쓰고 backend가 읽는다)
STATE_DIR=/app/.state
# 생성된 asset 번들
BUILD_DIR=/app/.build

# ---------------------------------------------------------------- backend
# GET /api/data/{dataset}가 돌려주는 최대 행 수
DATA_MAX_ROWS=5000

# ---------------------------------------------------------------- 관리 서비스(make manage. contracts/manage.md)
# 직접 입력·붙여넣기 한 번의 행 수
INGEST_INLINE_MAX_ROWS=500
# 파일 하나의 한도(MB, 행)
INGEST_MAX_UPLOAD_MB=200
INGEST_MAX_ROWS=2000000
# 여러 파일을 한 번에 올릴 때의 합계(MB)
INGEST_MAX_REQUEST_MB=500
# 배치 수가 이 수를 넘으면 합치기를 권한다
INGEST_COMPACT_HINT=200
# 조회 시간 제한(밀리초)
MANAGE_STATEMENT_TIMEOUT_MS=15000
# 즉시 응답(직접 입력·붙여넣기, 빠른 취소)의 쓰기 잠금 대기 시간(밀리초). 넘으면 409 apply_running
MANAGE_LOCK_WAIT_MS=5000
# 202 비동기 작업의 쓰기 잠금 대기 시간(밀리초). 넘으면 작업이 409 apply_running으로 실패
MANAGE_JOB_LOCK_WAIT_MS=600000
# 켤 선택 기능(쉼표 구분, 기본 비어 있음: export, profile, freshness, sql, tokens)
MANAGE_FEATURES=
# CSV 내보내기 최대 행 수(MANAGE_FEATURES=export일 때)
EXPORT_MAX_ROWS=1000000

# ---------------------------------------------------------------- 로그인(contracts/auth.md)
# 가입·초대를 허용하는 메일 도메인(쉼표 구분, 필수). 없으면 backend가 시작하지 않는다. 회사 도메인으로 바꾼다
AUTH_EMAIL_DOMAINS=example.com
# 메일 발송 방식: test(기본. 보내지 않고 운용 화면의 테스트 메일함에 쌓는다) · smtp(회사 메일 시스템. 아직 구현되지 않음)
AUTH_MAIL_MODE=test
# 메일 링크의 주소(브라우저가 웹앱을 여는 주소)
WEB_PUBLIC_URL=http://localhost:8080
# 1이면 세션 쿠키에 Secure를 붙인다. HTTPS로 배포할 때는 반드시 1
AUTH_COOKIE_SECURE=0
# 세션 만료: 마지막 사용 후(분), 로그인 후 최대(일)
AUTH_SESSION_IDLE_MINUTES=480
AUTH_SESSION_MAX_DAYS=7
