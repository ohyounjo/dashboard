{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dashkit.invalid/contracts/dashboard.schema.json",
  "title": "projects/<이름>/dashboard.yaml",
  "description": "앱, 데이터셋(dash.<키> 뷰), Superset 대시보드, 웹앱 탭. 키 사이의 참조는 dashkit/config.py가 검사한다(contracts/README.md의 '참조 검사' 표).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "datasets",
    "dashboards",
    "tabs"
  ],
  "properties": {
    "version": {
      "$ref": "#/$defs/version"
    },
    "app": {
      "$ref": "#/$defs/app"
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      }
    },
    "dashboards": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/key"
      },
      "additionalProperties": {
        "$ref": "#/$defs/dashboard"
      }
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tab"
      }
    }
  },
  "$defs": {
    "version": {
      "description": "설정 형식 버전(선택. 없으면 1). 이 dashkit이 지원하는 버전보다 크면 config.py가 '<파일>:version: …' 오류로 거부한다. 형식 변경 기록은 CHANGELOG.md, 고치는 명령은 dashkit migrate.",
      "type": "integer",
      "minimum": 1
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "column": {
      "description": "데이터셋 뷰의 열 이름",
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "icon": {
      "description": "웹앱 내장 아이콘(contracts/icons.md)",
      "enum": [
        "grid",
        "calendar",
        "alert",
        "doc",
        "chart",
        "table",
        "users",
        "box",
        "list",
        "flag",
        "target",
        "cart",
        "megaphone",
        "home"
      ]
    },
    "tone": {
      "description": "웹앱 색조 토큰. primary=메인 컬러, good/warn/bad=상태색, neutral=회색",
      "enum": [
        "primary",
        "good",
        "warn",
        "bad",
        "neutral"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "as_of"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "logo_text": {
          "description": "Rail 상단 로고 자리의 1~3글자",
          "type": "string",
          "minLength": 1,
          "maxLength": 3
        },
        "as_of": {
          "description": "기준일. \"today\"면 적재·요청 시점의 날짜(TZ 환경변수 기준), 날짜면 고정. SQL에서는 dash.as_of()",
          "oneOf": [
            {
              "const": "today"
            },
            {
              "$ref": "#/$defs/date"
            }
          ]
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "light",
                "dark"
              ],
              "properties": {
                "light": {
                  "$ref": "#/$defs/color"
                },
                "dark": {
                  "$ref": "#/$defs/color"
                }
              }
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql": {
          "description": "뷰 본문 SELECT. raw.*, dash.as_of(), 앞서 정의한 dash.<다른 데이터셋>을 쓸 수 있다",
          "type": "string",
          "minLength": 1
        },
        "table": {
          "description": "schema.yaml의 테이블 키. SELECT * FROM raw.<table> 축약",
          "$ref": "#/$defs/key"
        },
        "metrics": {
          "description": "이름 → SQL 집계식. Superset 데이터셋 지표가 된다",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "description": "열 또는 지표 이름 → 화면 표시 이름. Superset 데이터셋의 verbose_name(표 머리글, 필터·범례 라벨)이 된다",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/column"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "sql"
          ]
        },
        {
          "required": [
            "table"
          ]
        }
      ]
    },
    "metric_ref": {
      "description": "문자열 = 데이터셋 지표 이름, 객체 = 이 차트만의 식",
      "oneOf": [
        {
          "$ref": "#/$defs/key"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sql",
            "label"
          ],
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "time_grain": {
      "enum": [
        "P1D",
        "P1W",
        "P1M",
        "P3M",
        "P1Y"
      ]
    },
    "order_by": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/column"
          },
          {
            "enum": [
              "asc",
              "desc"
            ]
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "chart": {
      "type": "object",
      "required": [
        "key",
        "title",
        "dataset"
      ],
      "properties": {
        "key": {
          "description": "프로젝트 안에서 유일(모든 대시보드 통틀어)",
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "$ref": "#/$defs/key"
        },
        "viz": {
          "description": "축약 유형. 허용 값과 유형별 필드(v_<viz>)는 dashkit/charts/<viz>.yaml에서 로딩 때 합성한다(dashkit.charts.extend_schema)",
          "type": "string"
        },
        "viz_type": {
          "description": "축약 문법 밖의 Superset viz_type. 이때 params에 원본 파라미터를 모두 쓴다",
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "params": {
          "description": "Superset 원본 파라미터. 생성한 파라미터 위에 마지막으로 얕게 덮어쓴다",
          "type": "object"
        },
        "description": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "viz"
          ],
          "not": {
            "required": [
              "viz_type"
            ]
          }
        },
        {
          "required": [
            "viz_type",
            "params"
          ],
          "not": {
            "required": [
              "viz"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "viz_type"
            ]
          },
          "then": {
            "$ref": "#/$defs/v_raw"
          }
        }
      ]
    },
    "where": {
      "description": "이 차트에만 거는 SQL WHERE 조건(adhoc filter)",
      "type": "string",
      "minLength": 1
    },
    "format": {
      "description": "d3 숫자 형식(예: \".0f\", \",d\", \".1%\")",
      "type": "string",
      "minLength": 1
    },
    "v_raw": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": true,
        "title": true,
        "dataset": true,
        "viz_type": true,
        "params": true,
        "description": true
      }
    },
    "layout_item": {
      "oneOf": [
        {
          "$ref": "#/$defs/key"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chart"
          ],
          "properties": {
            "chart": {
              "$ref": "#/$defs/key"
            },
            "width": {
              "description": "12칸 격자 중 칸 수",
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "height": {
              "description": "Superset 격자 높이 단위(기본 50, 1단위≈8px)",
              "type": "integer",
              "minimum": 10,
              "maximum": 200
            }
          }
        },
        {
          "description": "제목(Superset HEADER). 한 행에 혼자 둔다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "header"
          ],
          "properties": {
            "header": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "description": "글(Superset MARKDOWN). 마크다운 문법을 쓴다",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "markdown"
          ],
          "properties": {
            "markdown": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "description": "12칸 격자 중 칸 수",
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "height": {
              "description": "Superset 격자 높이 단위(기본: 같은 행 차트의 가장 큰 높이, 차트가 없으면 20)",
              "type": "integer",
              "minimum": 5,
              "maximum": 200
            }
          }
        }
      ]
    },
    "layout_row": {
      "description": "행. 차트·글 항목의 목록이거나 제목 하나",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/layout_item"
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "description": "select(값 고르기, 기본) / time_range(기간) / number_range(숫자 범위) / time_grain(시간 단위). 유형별로 쓸 수 있는 필드는 contracts/chart-shorthand.md의 '필터' 표",
          "enum": [
            "select",
            "time_range",
            "number_range",
            "time_grain"
          ],
          "default": "select"
        },
        "multi": {
          "description": "select 전용",
          "type": "boolean",
          "default": true
        },
        "dataset": {
          "description": "select·number_range: 선택지(범위)를 읽을 데이터셋. 같은 열 이름을 가진 이 대시보드의 차트에 적용된다. time_grain: 고를 수 있는 단위를 읽을 데이터셋",
          "$ref": "#/$defs/key"
        },
        "column": {
          "description": "select·number_range 전용",
          "$ref": "#/$defs/column"
        },
        "default": {
          "description": "기본값. select: 값 또는 값 목록, number_range: [최소, 최대], time_range: Superset 시간 범위 문자열, time_grain: P1D 등"
        },
        "parent": {
          "description": "select 전용. 이 필터의 선택지를 좁히는 상위 필터의 key(연쇄)",
          "$ref": "#/$defs/key"
        },
        "charts": {
          "description": "이 필터를 적용할 차트 key 목록. 생략하면 대시보드의 모든 차트",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "select",
                  "number_range"
                ]
              }
            }
          },
          "then": {
            "required": [
              "dataset",
              "column"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "time_grain"
              }
            }
          },
          "then": {
            "required": [
              "dataset"
            ]
          }
        }
      ]
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "charts",
        "layout"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "charts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/chart"
          }
        },
        "cross_filters": {
          "description": "차트를 누르면 같은 대시보드의 다른 차트가 걸러진다(Superset cross filter)",
          "type": "boolean",
          "default": false
        },
        "layout": {
          "description": "행 목록. 각 항목은 행(차트·글 목록 또는 제목 하나)이거나 대시보드 안 탭 묶음({ tabs })이다. 모든 차트는 탭 안을 포함해 정확히 한 번 배치한다",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/layout_row"
              },
              {
                "description": "대시보드 안 탭(Superset TABS)",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tabs"
                ],
                "properties": {
                  "tabs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "rows"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rows": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "$ref": "#/$defs/layout_row"
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "icon",
        "sections"
      ],
      "properties": {
        "key": {
          "description": "해시 주소 #<key>",
          "$ref": "#/$defs/key"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "superset"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "superset"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/s_superset"
          }
        }
      ],
      "description": "섹션. superset은 여기 정의하고, 위젯 유형의 enum·분기·s_<유형> 정의는 web/widgets/<유형>/widget.json에서 로딩 때 합성한다(dashkit/widgets.py)"
    },
    "s_superset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "dashboard"
      ],
      "properties": {
        "type": true,
        "title": {
          "type": "string"
        },
        "dashboard": {
          "$ref": "#/$defs/key"
        },
        "height": {
          "description": "iframe 높이(px). 생략하면 SDK getScrollSize로 맞춘다",
          "type": "integer",
          "minimum": 200,
          "maximum": 5000
        }
      }
    },
    "status_map": {
      "description": "열 값 → 표시. 표에 없는 값은 값 그대로, tone neutral",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "description": "이모지 1개",
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "tone": {
            "$ref": "#/$defs/tone"
          }
        }
      }
    }
  }
}
